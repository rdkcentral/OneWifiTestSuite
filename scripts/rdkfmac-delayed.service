[Unit]
Description=Delayed rdkfmac Driver Start
ConditionPathExists=!/lib/systemd/system/wifi.service
After=wifi-initialized.target

[Service]
Type=simple
RemainAfterExit=no
TimeoutStartSec=0
Restart=on-failure
RestartSec=5
KillMode=control-group
ExecStart=/bin/sh -c '\
    up=$(cut -d. -f1 /proc/uptime); \
    if [ "$up" -lt 200 ]; then \
        sleep $((200 - up)); \
    fi; \
    exec /usr/bin/rdkfmac_modprobe.sh start'
ExecStop=/usr/bin/rdkfmac_modprobe.sh stop