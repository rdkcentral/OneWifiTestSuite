[Unit]
Description=Install rdkfmac Driver
# CcspPandMSsp (TR-181/PandM) owns onewifi_testsuite; the value is ready once it is active.
After=wifi.service CcspPandMSsp.service rbus.service CcspLMLite.service
Wants=CcspPandMSsp.service rbus.service CcspLMLite.service

[Service]
Type=forking
RemainAfterExit=yes
ExecStart=/usr/bin/rdkfmac_modprobe.sh start
ExecStop=/usr/bin/rdkfmac_modprobe.sh stop
Restart=always

[Install]
WantedBy=wifi-initialized.target
